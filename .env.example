# --- 前端（Vite，可選）---
# 若 API 部署在另一個 Vercel 網域，填完整 URL（結尾不要 /）
# 本機 dev 與同專案 Vercel 部署請留空，使用 /api
VITE_API_BASE_URL=

# Gemini（AI Studio / 未來功能）
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# --- Vercel Serverless（僅後端 api/ 使用，勿加 VITE_ 前綴）---
# Notion Integration Secret：https://www.notion.so/my-integrations
NOTION_API_KEY=

# Notion Database ID（資料庫頁面 URL 中的 32 字元 ID）
NOTION_DATABASE_ID_OUTFITS=
NOTION_DATABASE_ID_FEEDBACK=
NOTION_DATABASE_ID_INSPIRATION=
