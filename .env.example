# --- 前端（Vite，可選）---
# 若 API 部署在另一個 Vercel 網域，填完整 URL（結尾不要 /）
# 本機 dev 與同專案 Vercel 部署請留空，使用 /api
VITE_API_BASE_URL=

# Gemini（穿搭照片 AI 分類，僅後端 api/ 使用）
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google Weather API（僅後端 api/ 使用；未設定時改為 Open-Meteo）
# 1. Google Cloud Console 啟用「Weather API」並開啟計費
# 2. 建立 API 金鑰並限制為 Weather API
# https://developers.google.com/maps/documentation/weather/overview
GOOGLE_WEATHER_API_KEY=
# 相容：若已使用 Maps 金鑰可填 GOOGLE_MAPS_API_KEY
# GOOGLE_MAPS_API_KEY=
# 可選：指定模型（須支援圖片 + generateContent）
# GEMINI_MODEL=gemini-2.0-flash-lite
APP_URL="MY_APP_URL"

# --- Vercel Serverless（僅後端 api/ 使用，勿加 VITE_ 前綴）---
# Notion Integration Secret：https://www.notion.so/my-integrations
NOTION_API_KEY=

# 單一 Database（穿搭+天氣+體感），URL 中 32 字元 ID
# 欄位對照：api/lib/notion/schema.ts（須與 Notion 英文欄名一致）
# 研究用欄位 CurrentRanking（Multi-select，選項與 color 相同）：記錄當下定位區、同溫度區間地圖顏色排行第一
# 「Favorite」須為 Multi-select，寫在收藏者 active 列上；
# 選項 = 被收藏穿搭列的「ID」欄位值（非 Notion page id）
NOTION_DATABASE_ID=
# 相容舊名稱（二擇一即可）
NOTION_DATABASE_ID_OUTFITS=

# 本機測試：複製此檔為 .env.local 填入上方兩項，執行 pnpm test:notion
